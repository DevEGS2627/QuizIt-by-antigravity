# EGS Quizit! - Environment Variables Configuration Example
# Copy this file to .env to connect to your live Supabase project

# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anonymous Publishable Key (safe for client-side usage)
# NEVER put your Service Role Secret Key here!
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token-here

# Note: EGS Quizit! automatically operates in offline / local development mode
# with localStorage persistence if these variables are left empty.
