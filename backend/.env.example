# EGS Quizit! - Backend Environment Variables Configuration Example
# When you are ready to connect Supabase, copy this file to .env and add your anon key.
# Currently, the application and backend run 100% locally in offline/local-first mode.

# Target Supabase Project URL
VITE_SUPABASE_URL=https://zuhnkvclsflrhmmqwbdp.supabase.co
SUPABASE_URL=https://zuhnkvclsflrhmmqwbdp.supabase.co

# Supabase Anonymous Publishable Key (safe for client-side usage)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Note: The quiz engine operates 100% in local-only mode with memory/file persistence
# as long as no .env file is created or the anon key is left empty.
