# EGS Quizit! - Environment Variables Configuration Example
# When you are ready to connect Supabase, copy this file to .env and add your anon key.
# Currently, the application runs 100% locally in offline/local-first mode.

# Target Supabase Project URL
VITE_SUPABASE_URL=https://zuhnkvclsflrhmmqwbdp.supabase.co

# Supabase Anonymous Publishable Key (safe for client-side usage)
# Find this in your Supabase Dashboard: Project Settings -> API -> Project API keys -> 'anon' 'public'
# NEVER put your Service Role Secret Key here!
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Note: EGS Quizit operates 100% in local-only mode with localStorage persistence
# as long as no .env file is created or the anon key is left empty.
